# =============================================================================
# llama.cpp maximal performance environment
# Source this file before running llama-cli or llama-server:
#   source scripts/optimize.env
#
# Hardware: Intel i5-8365U (4C/8T, AVX2), Intel UHD 620 iGPU
# =============================================================================

# --- Threading ---
# CPU threads = physical cores (avoid SMT for memory-bound workloads)
export LLAMA_ARG_THREADS=4
# Batch threads same as generation threads
# (set via --threads-batch or env)

# --- Memory ---
# Lock model in RAM (prevents swapping)
export LLAMA_ARG_MLOCK=1
# Memory-map model (faster load, may reduce perf for generation)
# export LLAMA_ARG_MMAP=1

# --- KV Cache ---
# Quantize K and V cache to Q4_0 (reduces memory bandwidth by 4x)
export LLAMA_ARG_CACHE_TYPE_K=q4_0
export LLAMA_ARG_CACHE_TYPE_V=q4_0

# --- Batch ---
export LLAMA_ARG_BATCH=2048
export LLAMA_ARG_UBATCH=512

# --- GPU ---
# iGPU is slower than CPU on this hardware; disable by default
# Uncomment below to force GPU offload:
# export LLAMA_ARG_N_GPU_LAYERS=0

# --- Vulkan backend tuning (if GPU is used) ---
# Disable cooperative matrix (not supported on Gen9.5)
export GGML_VK_DISABLE_COOPMAT=1
export GGML_VK_DISABLE_COOPMAT2=1
# Disable bfloat16 (not supported on Gen9.5)
export GGML_VK_DISABLE_BFLOAT16=1
# Disable async (may reduce overhead on some Intel drivers)
# export GGML_VK_DISABLE_ASYNC=1
# Disable op fusion (debug only)
# export GGML_VK_DISABLE_FUSION=1
# Disable integer dot product
export GGML_VK_DISABLE_INTEGER_DOT_PRODUCT=1

# --- NUMA ---
# Single socket system, no NUMA effect
# (used via --numa flag, env not supported for this option)

# --- Performance profiling ---
# Enable internal perf timings
# export LLAMA_ARG_PERF=1

# --- OpenMP ---
# OMP threads = physical cores
export OMP_NUM_THREADS=4
# Use static scheduling for predictable performance
export OMP_SCHEDULE=static

# --- Malloc ---
# Use jemalloc or tcmalloc if available for reduced fragmentation
# LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so
